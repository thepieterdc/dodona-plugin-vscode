{
  "compilerOptions": {
    "allowJs": false,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "CommonJS",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./out",
    "removeComments": true,
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["mocha", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "out"]
}